{
  "name": "dsh-info-radar",
  "version": "1.0.0",
  "private": true,
  "description": "信息雷达：按网址定时抓取内容、按需 AI 总结、左侧栏未读红点提醒，并可选择通过 DSH-IM 机器人（微信 / QQ / 飞书…）推送通知",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "rss",
    "watch",
    "summarize"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJilove123456/dsh-information-radar.git"
  },
  "bugs": {
    "url": "https://github.com/JJilove123456/dsh-information-radar/issues"
  },
  "homepage": "https://github.com/JJilove123456/dsh-information-radar#readme",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
